<launch>
    <!-- local_map_pub.cpp：订阅 /velodyne_points，构建局部栅格地图，拟合障碍物椭圆，并发布障碍物观测数据。 -->
    <node pkg="local_map" type="local_map_pub" output="screen" name="local_map_pub">  
        <!-- 局部地图尺寸与栅格分辨率。 -->
        <param name="localmap_x_size" value="14"/>  
        <param name="localmap_y_size" value="14"/>
        <param name="resolution" value="0.1"/>
        <!-- 点云高度过滤阈值，用于区分障碍物/台阶等点。 -->
        <param name="obs_height" value="0.4"/>
        <param name="step_height" value="0.5"/>
        <!-- DBSCAN 聚类参数，用于椭圆拟合和障碍物跟踪前的点云聚类。 -->
        <param name="DBSCAN_R" value="5.0"/>
        <param name="DBSCAN_N" value="4"/>
    </node>
</launch>

<launch>
  <!-- Research profile for near-cylindrical external obstacles. -->
  <arg name="circle_prior_retention" default="true" />
  <arg name="scenario" default="active_oblique_crossing" />
  <arg name="gui" default="true" />
  <arg name="open_rviz" default="true" />
  <arg name="gazebo_seed" default="211" />
  <arg name="output_dir" default="" />
  <arg name="log_cluster_points" default="false" />
  <param name="/cbf/dynamic/log_cluster_points" value="$(arg log_cluster_points)" type="bool" />
  <include file="$(find tb3_distributed_control)/launch/single_turtlebot3_cbf_trigger022.launch">
    <arg name="motion_geometry_observer" value="circle" />
    <arg name="circle_prior_retention" value="$(arg circle_prior_retention)" />
    <arg name="scenario" value="$(arg scenario)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="open_rviz" value="$(arg open_rviz)" />
    <arg name="gazebo_seed" value="$(arg gazebo_seed)" />
    <arg name="output_dir" value="$(arg output_dir)" />
  </include>
</launch>

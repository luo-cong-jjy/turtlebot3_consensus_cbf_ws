<launch>
  <!-- Nominal formation compatibility only: no external obstacles or spatial-pass algorithm. -->
  <arg name="gui" default="true" />
  <arg name="open_rviz" default="true" />
  <arg name="gazebo_seed" default="211" />
  <arg name="output_dir" default="" />
  <arg name="total_time" default="30" />
  <include file="$(find tb3_distributed_control)/launch/multi_turtlebot3_consensus_gazebo_cbf.launch">
    <arg name="world_name" value="$(find tb3_distributed_control)/worlds/consensus_dynamic_obstacles.world" />
    <arg name="robot_count" value="5" />
    <arg name="formation_radius" value="0.4" />
    <arg name="trajectory_type" value="line" />
    <arg name="leader_init_x" value="0" />
    <arg name="leader_init_y" value="0" />
    <arg name="dynamic_prediction" value="true" />
    <arg name="static_accumulation" value="false" />
    <arg name="spatial_pass" value="false" />
    <arg name="peer_safety" value="true" />
    <arg name="execution_backup" value="true" />
    <arg name="spatial_runtime_guard" value="true" />
    <arg name="log_mpc_inputs" value="true" />
    <arg name="robot0_init_x" value="0.4000000000" />
    <arg name="robot0_init_y" value="0.0000000000" />
    <arg name="robot1_init_x" value="0.1236067977" />
    <arg name="robot1_init_y" value="0.3804226065" />
    <arg name="robot2_init_x" value="-0.3236067977" />
    <arg name="robot2_init_y" value="0.2351141009" />
    <arg name="robot3_init_x" value="-0.3236067977" />
    <arg name="robot3_init_y" value="-0.2351141009" />
    <arg name="robot4_init_x" value="0.1236067977" />
    <arg name="robot4_init_y" value="-0.3804226065" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="open_rviz" value="$(arg open_rviz)" />
    <arg name="gazebo_seed" value="$(arg gazebo_seed)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="total_time" value="$(arg total_time)" />
  </include>
</launch>

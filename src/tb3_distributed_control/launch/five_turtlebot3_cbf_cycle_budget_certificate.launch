<launch>
  <arg name="cycle_budget_guard" default="true" />
  <arg name="budget_objective_gap" default="0.045" />
  <arg name="local_cluster_recording" default="false" />
  <param name="/cbf/dynamic/local_cluster_recording" value="$(arg local_cluster_recording)" type="bool" />
  <arg name="scenario" default="active_overtaking" />
  <arg name="active_experiment" default="true" />
  <arg name="local_reference_mode" default="timed" />
  <arg name="spatial_pass" default="true" />
  <arg name="spatial_compiled_rollout" default="true" />
  <arg name="spatial_timeout_carry" default="true" />
  <arg name="spatial_lateral_extras" default="[0.12,0.22,0.32]" />
  <arg name="spatial_shift_durations" default="[2.0,3.0,4.0]" />
  <arg name="spatial_predictive_return" default="true" />
  <arg name="spatial_return_durations" default="[3.0,4.5,6.0]" />
  <arg name="spatial_activation_threshold" default="0.22" />
  <arg name="spatial_activation_preview_seconds" default="2.0" />
  <arg name="spatial_runtime_guard" default="true" />
  <arg name="spatial_prefix_retention" default="true" />
  <arg name="total_time" default="40" />
  <arg name="gui" default="true" />
  <arg name="open_rviz" default="true" />
  <arg name="geometry_debug" default="false" />
  <arg name="geometry_observer" default="0" />
  <arg name="output_dir" default="" />
  <arg name="gazebo_seed" default="" />
  <arg name="progress_hypotheses" default="true" />
  <arg name="adaptive_recovery" default="false" />
  <arg name="transport_geometry" default="true" />
  <arg name="predictive_bypass" default="false" />
  <arg name="active_guidance_only" default="false" />
  <arg name="prediction_risk" default="false" />
  <arg name="suppress_guidance" default="false" />
  <arg name="risk_weight" default="3.0" />
  <arg name="risk_clearance" default="0.35" />
  <arg name="risk_discount" default="0.5" />
  <arg name="risk_tail_seconds" default="0.0" />
  <arg name="constraint_mode" default="dcbf" />
  <arg name="risk_penalty" default="clearance_quartic" />
  <arg name="wang_alpha" default="1.0" />
  <arg name="wang_mu" default="0.1" />
  <arg name="wang_iota" default="0.02" />
  <arg name="wang_radius" default="1.0" />
  <arg name="mpc_horizon" default="10" />
  <arg name="pending_seed_with_backup" default="false" />
  <arg name="log_mpc_inputs" default="true" />
  <arg name="rear_pass" default="false" />
  <arg name="rear_preview_seconds" default="6.0" />
  <arg name="infeasible_escape" default="false" />
  <arg name="execution_backup" default="true" />
  <arg name="progress_abstain" default="true" />
  <arg name="progress_guidance" default="false" />
  <arg name="prediction_mode" default="cv" />
  <arg name="motion_geometry_observer" default="circle" />
  <arg name="circle_prior_retention" default="true" />
  <arg name="known_radius" default="0.12" />
  <arg name="known_radius_tolerance" default="0.005" />
  <arg name="known_point_error" default="0.01" />
  <arg name="known_radius_refine" default="true" />
  <arg name="known_noise_sigma" default="0.01" />
  <arg name="known_noise_alpha" default="0.01" />
  <arg name="known_range_error" default="0.015" />
  <arg name="known_transform_error" default="0.0" />
  <arg name="moving_frame_projection" default="false" />
  <arg name="singer_tau" default="1.0" />
  <arg name="acceleration_buffer" default="true" />
  <arg name="stage_velocity_guidance" default="true" />
  <arg name="ca_jerk_density" default="0.01" />
  <arg name="ca_acceleration_variance" default="0.04" />
  <arg name="dynamic_reaction_time" default="0.35" />
  <arg name="dynamic_extra_margin" default="0.02" />
  <include file="$(find tb3_distributed_control)/launch/multi_turtlebot3_consensus_gazebo_cbf.launch">
    <arg name="world_name" value="$(find tb3_distributed_control)/worlds/consensus_dynamic_obstacles.world" />
    <arg name="cycle_budget_guard" value="$(arg cycle_budget_guard)" />
    <arg name="budget_objective_gap" value="$(arg budget_objective_gap)" />
    <arg name="robot_count" value="5" />
    <arg name="rviz_config" value="$(find tb3_distributed_control)/rviz/tb3_cbf_five_motion_geometry.rviz" />
    <arg name="formation_radius" value="0.4" />
    <arg name="trajectory_type" value="line" />
    <arg name="leader_init_x" value="0.0" />
    <arg name="leader_init_y" value="0.0" />
    <arg name="robot0_init_x" value="0.4000000000" />
    <arg name="robot0_init_y" value="0.0000000000" />
    <arg name="robot1_init_x" value="0.1236067977" />
    <arg name="robot1_init_y" value="0.3804226065" />
    <arg name="robot2_init_x" value="-0.3236067977" />
    <arg name="robot2_init_y" value="0.2351141009" />
    <arg name="robot3_init_x" value="-0.3236067977" />
    <arg name="robot3_init_y" value="-0.2351141009" />
    <arg name="robot4_init_x" value="0.1236067977" />
    <arg name="robot4_init_y" value="-0.3804226065" />
    <arg name="sensor_ready_delay" value="0.8" />
    <arg name="five_robot_experiment" value="true" />
    <arg name="active_scenario_file" value="$(find tb3_distributed_control)/config/cbf_bin012_scenarios.yaml" />
    <arg name="active_protocol_file" value="$(find tb3_distributed_control)/config/cbf_five_bin012_protocol.yaml" />
    <arg name="dynamic_prediction" value="true" />
    <arg name="static_accumulation" value="false" />
    <arg name="dynamic_scenario" value="$(arg scenario)" />
    <arg name="active_experiment" value="$(arg active_experiment)" />
    <arg name="local_reference_mode" value="$(arg local_reference_mode)" />
    <arg name="spatial_pass" value="$(arg spatial_pass)" />
    <arg name="spatial_compiled_rollout" value="$(arg spatial_compiled_rollout)" />
    <arg name="spatial_timeout_carry" value="$(arg spatial_timeout_carry)" />
    <arg name="spatial_lateral_extras" value="$(arg spatial_lateral_extras)" />
    <arg name="spatial_shift_durations" value="$(arg spatial_shift_durations)" />
    <arg name="spatial_predictive_return" value="$(arg spatial_predictive_return)" />
    <arg name="spatial_return_durations" value="$(arg spatial_return_durations)" />
    <arg name="spatial_activation_threshold" value="$(arg spatial_activation_threshold)" />
    <arg name="spatial_activation_preview_seconds" value="$(arg spatial_activation_preview_seconds)" />
    <arg name="spatial_runtime_guard" value="$(arg spatial_runtime_guard)" />
    <arg name="spatial_prefix_retention" value="$(arg spatial_prefix_retention)" />
    <arg name="ca_jerk_density" value="$(arg ca_jerk_density)" />
    <arg name="ca_acceleration_variance" value="$(arg ca_acceleration_variance)" />
    <arg name="moving_frame_projection" value="$(arg moving_frame_projection)" />
    <arg name="singer_tau" value="$(arg singer_tau)" />
    <arg name="acceleration_buffer" value="$(arg acceleration_buffer)" />
    <arg name="stage_velocity_guidance" value="$(arg stage_velocity_guidance)" />
    <arg name="gazebo_seed" value="$(arg gazebo_seed)" />
    <arg name="progress_hypotheses" value="$(arg progress_hypotheses)" />
    <arg name="adaptive_recovery" value="$(arg adaptive_recovery)" />
    <arg name="transport_geometry" value="$(arg transport_geometry)" />
    <arg name="predictive_bypass" value="$(arg predictive_bypass)" />
    <arg name="active_guidance_only" value="$(arg active_guidance_only)" />
    <arg name="prediction_risk" value="$(arg prediction_risk)" />
    <arg name="suppress_guidance" value="$(arg suppress_guidance)" />
    <arg name="risk_weight" value="$(arg risk_weight)" />
    <arg name="risk_clearance" value="$(arg risk_clearance)" />
    <arg name="risk_discount" value="$(arg risk_discount)" />
    <arg name="risk_tail_seconds" value="$(arg risk_tail_seconds)" />
    <arg name="constraint_mode" value="$(arg constraint_mode)" />
    <arg name="risk_penalty" value="$(arg risk_penalty)" />
    <arg name="wang_alpha" value="$(arg wang_alpha)" />
    <arg name="wang_mu" value="$(arg wang_mu)" />
    <arg name="wang_iota" value="$(arg wang_iota)" />
    <arg name="wang_radius" value="$(arg wang_radius)" />
    <arg name="mpc_horizon" value="$(arg mpc_horizon)" />
    <arg name="pending_seed_with_backup" value="$(arg pending_seed_with_backup)" />
    <arg name="log_mpc_inputs" value="$(arg log_mpc_inputs)" />
    <arg name="rear_pass" value="$(arg rear_pass)" />
    <arg name="rear_preview_seconds" value="$(arg rear_preview_seconds)" />
    <arg name="infeasible_escape" value="$(arg infeasible_escape)" />
    <arg name="execution_backup" value="$(arg execution_backup)" />
    <arg name="progress_abstain" value="$(arg progress_abstain)" />
    <arg name="progress_guidance" value="$(arg progress_guidance)" />
    <arg name="prediction_mode" value="$(arg prediction_mode)" />
    <arg name="motion_geometry_observer" value="$(arg motion_geometry_observer)" />
    <arg name="circle_prior_retention" value="$(arg circle_prior_retention)" />
    <arg name="known_radius" value="$(arg known_radius)" />
    <arg name="known_radius_tolerance" value="$(arg known_radius_tolerance)" />
    <arg name="known_point_error" value="$(arg known_point_error)" />
    <arg name="known_radius_refine" value="$(arg known_radius_refine)" />
    <arg name="known_noise_sigma" value="$(arg known_noise_sigma)" />
    <arg name="known_noise_alpha" value="$(arg known_noise_alpha)" />
    <arg name="known_range_error" value="$(arg known_range_error)" />
    <arg name="known_transform_error" value="$(arg known_transform_error)" />
    <arg name="dynamic_reaction_time" value="$(arg dynamic_reaction_time)" />
    <arg name="dynamic_extra_margin" value="$(arg dynamic_extra_margin)" />
    <arg name="total_time" value="$(arg total_time)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="open_rviz" value="$(arg open_rviz)" />
    <arg name="geometry_debug" value="$(arg geometry_debug)" />
    <arg name="geometry_observer" value="$(arg geometry_observer)" />
    <arg name="output_dir" value="$(arg output_dir)" />
  </include>
</launch>

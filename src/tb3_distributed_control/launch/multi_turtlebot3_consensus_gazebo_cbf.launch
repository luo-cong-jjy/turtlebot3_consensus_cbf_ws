<launch>
  <arg name="model" default="$(optenv TURTLEBOT3_MODEL burger)" />
  <arg name="total_time" default="180" />
  <arg name="trajectory_type" default="eight_slow_slow" />
  <arg name="gui" default="true" />
  <arg name="open_rviz" default="true" />
  <arg name="paused" default="false" />
  <arg name="dynamic_scenario" default="none" />
  <arg name="active_experiment" default="false" />
  <arg name="two_robot_experiment" default="false" />
  <arg name="five_robot_experiment" default="false" />
  <arg name="active_scenario_file" default="$(find tb3_distributed_control)/config/cbf_active_avoidance_scenarios.yaml" />
  <arg name="active_protocol_file" default="$(find tb3_distributed_control)/config/cbf_active_avoidance_protocol.yaml" />
  <arg name="robot0_init_x" default="0.4" />
  <arg name="robot0_init_y" default="0.0" />
  <arg name="robot1_init_x" default="0.2" />
  <arg name="robot1_init_y" default="0.4" />
  <arg name="robot2_init_x" default="-0.2" />
  <arg name="robot2_init_y" default="0.2" />
  <arg name="robot3_init_x" default="-0.3" />
  <arg name="robot3_init_y" default="-0.3" />
  <arg name="robot4_init_x" default="0.2" />
  <arg name="robot4_init_y" default="-0.3" />
  <arg name="local_reference_mode" default="timed" />
  <arg name="spatial_pass" default="false" />
  <arg name="spatial_compiled_rollout" default="false" />
  <arg name="spatial_timeout_carry" default="false" />
  <arg name="spatial_lateral_extras" default="[0.12,0.22,0.32]" />
  <arg name="spatial_shift_durations" default="[4.5,6.0,7.5]" />
  <arg name="spatial_predictive_return" default="false" />
  <arg name="spatial_return_durations" default="[3.0,4.5,6.0]" />
  <arg name="spatial_activation_threshold" default="-1.0" />
  <arg name="spatial_activation_preview_seconds" default="1.0" />
  <arg name="spatial_runtime_guard" default="false" />
  <arg name="spatial_prefix_retention" default="false" />
  <arg name="world_name" default="$(eval find('tb3_distributed_control') + '/worlds/' + ('consensus_obstacle_1.world' if arg('dynamic_scenario') == 'none' else 'consensus_dynamic_obstacles.world'))" />
  <!-- Empty output_dir creates a unique timestamped experiment in data_collect. -->
  <arg name="output_dir" default="" />
  <arg name="run_id" default="$(anon cbf_run)" />
  <arg name="geometry_observer" default="0" />
  <arg name="geometry_debug" default="false" />
  <arg name="formation_radius" default="0.5" />
  <arg name="sensor_ready_delay" default="0.0" />
  <arg name="robot_count" default="5" />
  <arg name="rviz_config" default="$(eval find('tb3_distributed_control') + '/rviz/' + ('tb3_cbf_single.rviz' if int(arg('robot_count')) == 1 else 'tb3_cbf.rviz'))" />
  <arg name="dynamic_prediction" default="$(eval arg('dynamic_scenario') != 'none')" />
  <arg name="gazebo_seed" default="" />
  <arg name="progress_hypotheses" default="true" />
  <arg name="adaptive_recovery" default="false" />
  <arg name="transport_geometry" default="false" />
  <arg name="predictive_bypass" default="false" />
  <arg name="active_guidance_only" default="false" />
  <arg name="prediction_risk" default="false" />
  <arg name="suppress_guidance" default="false" />
  <arg name="risk_weight" default="3.0" />
  <arg name="risk_clearance" default="0.35" />
  <arg name="risk_discount" default="0.5" />
  <arg name="risk_tail_seconds" default="0.0" />
  <arg name="constraint_mode" default="dcbf" />
  <arg name="risk_penalty" default="clearance_quartic" />
  <arg name="wang_alpha" default="1.0" />
  <arg name="wang_mu" default="0.1" />
  <arg name="wang_iota" default="0.02" />
  <arg name="wang_radius" default="1.0" />
  <arg name="mpc_horizon" default="10" />
  <arg name="pending_seed_with_backup" default="false" />
  <arg name="log_mpc_inputs" default="false" />
  <arg name="rear_pass" default="false" />
  <arg name="rear_preview_seconds" default="6.0" />
  <arg name="infeasible_escape" default="false" />
  <arg name="execution_backup" default="false" />
  <arg name="progress_abstain" default="true" />
  <arg name="progress_guidance" default="false" />
  <arg name="prediction_mode" default="cv" />
  <arg name="motion_geometry_observer" default="mvee" />
  <arg name="circle_prior_retention" default="false" />
  <arg name="known_radius" default="0.0" />
  <arg name="known_radius_tolerance" default="0.005" />
  <arg name="known_point_error" default="0.01" />
  <arg name="known_radius_refine" default="false" />
  <arg name="gc_diagnostics" default="false" />
  <arg name="compact_solver_history" default="false" />
  <arg name="cycle_budget_guard" default="false" />
  <arg name="cycle_scheduler_guard" default="false" />
  <arg name="budget_objective_gap" default="0.0" />
  <arg name="known_noise_sigma" default="0.0" />
  <arg name="known_noise_alpha" default="0.01" />
  <arg name="known_range_error" default="0.0" />
  <arg name="known_transform_error" default="0.0" />
  <arg name="moving_frame_projection" default="false" />
  <arg name="singer_tau" default="1.0" />
  <arg name="acceleration_buffer" default="true" />
  <arg name="stage_velocity_guidance" default="true" />
  <arg name="ca_jerk_density" default="0.01" />
  <arg name="ca_acceleration_variance" default="0.04" />
  <arg name="dynamic_reaction_time" default="0.35" />
  <arg name="dynamic_extra_margin" default="0.02" />
  <arg name="peer_safety" default="true" />
  <!-- Minimum peer envelope size; laser contours cannot shrink this prior. -->
  <arg name="peer_radius" default="0.20" />
  <arg name="stall_recovery" default="true" />
  <arg name="realtime_solver" default="true" />
  <arg name="control_budget_ms" default="100" />
  <arg name="nlp_budget_ms" default="65" />
  <arg name="dual_warm_start" default="true" />
  <arg name="stagger_callbacks" default="true" />
  <arg name="static_accumulation" default="$(eval arg('dynamic_scenario') == 'none')" />
  <arg name="recovery_gamma" default="0.03" />
  <param name="/cbf/recovery_gamma" value="$(arg recovery_gamma)" />
  <arg name="leader_init_x" default="0.0" />
  <arg name="leader_init_y" default="0.3" />
  <param name="/cbf/gazebo_seed" value="$(arg gazebo_seed)" type="str" />
  <param name="/use_sim_time" value="true" />
  <rosparam param="/cbf/robot_names" subst_value="true">$(eval ['tb3_0','tb3_1','tb3_2','tb3_3','tb3_4'][:int(arg('robot_count'))])</rosparam>
  <rosparam param="/cbf/adjacency" subst_value="true">$(eval [[0, 0, 0, 0, 0][:int(arg('robot_count'))], [1, 0, 0, 0, 0][:int(arg('robot_count'))], [0, 1, 0, 0, 0][:int(arg('robot_count'))], [0, 0, 1, 0, 0][:int(arg('robot_count'))], [0, 0, 0, 1, 0][:int(arg('robot_count'))]][:int(arg('robot_count'))])</rosparam>
  <rosparam param="/cbf/pinning" subst_value="true">$(eval [1,0,0,0,0][:int(arg('robot_count'))])</rosparam>
  <param name="/cbf/dynamic_prediction" value="$(arg dynamic_prediction)" type="bool" />
  <param name="/cbf/dynamic/ca_jerk_density" value="$(arg ca_jerk_density)" />
  <param name="/cbf/dynamic/ca_acceleration_variance" value="$(arg ca_acceleration_variance)" />
  <param name="/cbf/progress_hypotheses" value="$(arg progress_hypotheses)" />
  <param name="/cbf/adaptive_recovery" value="$(arg adaptive_recovery)" />
  <param name="/cbf/dynamic/transport_geometry" value="$(arg transport_geometry)" />
  <param name="/cbf/predictive_bypass" value="$(arg predictive_bypass)" />
  <param name="/cbf/active_guidance_only" value="$(arg active_guidance_only)" />
  <param name="/cbf/prediction_risk" value="$(arg prediction_risk)" />
  <param name="/cbf/suppress_guidance" value="$(arg suppress_guidance)" />
  <param name="/cbf/mpc/risk_weight" value="$(arg risk_weight)" />
  <param name="/cbf/mpc/risk_clearance" value="$(arg risk_clearance)" />
  <param name="/cbf/mpc/risk_discount" value="$(arg risk_discount)" />
  <param name="/cbf/mpc/risk_tail_seconds" value="$(arg risk_tail_seconds)" />
  <param name="/cbf/mpc/constraint_mode" value="$(arg constraint_mode)" />
  <param name="/cbf/mpc/risk_penalty" value="$(arg risk_penalty)" />
  <param name="/cbf/mpc/wang_alpha" value="$(arg wang_alpha)" />
  <param name="/cbf/mpc/wang_mu" value="$(arg wang_mu)" />
  <param name="/cbf/mpc/wang_iota" value="$(arg wang_iota)" />
  <param name="/cbf/mpc/wang_radius" value="$(arg wang_radius)" />
  <param name="/cbf/mpc/horizon" value="$(arg mpc_horizon)" type="int" />
  <param name="/cbf/mpc/pending_seed_with_backup" value="$(arg pending_seed_with_backup)" />
  <param name="/cbf/mpc/log_mpc_inputs" value="$(arg log_mpc_inputs)" />
  <param name="/cbf/mpc/rear_pass" value="$(arg rear_pass)" />
  <param name="/cbf/mpc/rear_preview_seconds" value="$(arg rear_preview_seconds)" />
  <param name="/cbf/infeasible_escape" value="$(arg infeasible_escape)" />
  <param name="/cbf/execution_backup" value="$(arg execution_backup)" />
  <param name="/cbf/progress_abstain" value="$(arg progress_abstain)" />
  <param name="/cbf/progress_guidance" value="$(arg progress_guidance)" />
  <param name="/cbf/moving_frame_projection" value="$(arg moving_frame_projection)" />
  <param name="/cbf/dynamic/singer_tau" value="$(arg singer_tau)" />
  <param name="/cbf/dynamic/acceleration_buffer" value="$(arg acceleration_buffer)" />
  <param name="/cbf/dynamic/stage_velocity_guidance" value="$(arg stage_velocity_guidance)" />
  <param name="/cbf/dynamic/prediction_mode" value="$(arg prediction_mode)" />
  <param name="/cbf/dynamic/geometry_observer" value="$(arg motion_geometry_observer)" />
  <param name="/cbf/dynamic/circle_prior_retention" value="$(arg circle_prior_retention)" type="bool" />
  <param name="/cbf/dynamic/known_radius" value="$(arg known_radius)" type="double" />
  <param name="/cbf/dynamic/known_radius_tolerance" value="$(arg known_radius_tolerance)" type="double" />
  <param name="/cbf/dynamic/known_point_error" value="$(arg known_point_error)" type="double" />
  <param name="/cbf/dynamic/known_radius_refine" value="$(arg known_radius_refine)" type="bool" />
  <param name="/cbf/mpc/budget_objective_gap" value="$(arg budget_objective_gap)" type="double" />
  <param name="/cbf/mpc/cycle_scheduler_guard" value="$(arg cycle_scheduler_guard)" type="bool" />
  <param name="/cbf/mpc/compact_solver_history" value="$(arg compact_solver_history)" type="bool" />
  <param name="/cbf/mpc/gc_diagnostics" value="$(arg gc_diagnostics)" type="bool" />
  <param name="/cbf/mpc/cycle_budget_guard" value="$(arg cycle_budget_guard)" type="bool" />
  <param name="/cbf/dynamic/known_noise_sigma" value="$(arg known_noise_sigma)" type="double" />
  <param name="/cbf/dynamic/known_noise_alpha" value="$(arg known_noise_alpha)" type="double" />
  <param name="/cbf/dynamic/known_range_error" value="$(arg known_range_error)" type="double" />
  <param name="/cbf/dynamic/known_transform_error" value="$(arg known_transform_error)" type="double" />
  <param name="/cbf/dynamic/reaction_time" value="$(arg dynamic_reaction_time)" />
  <param name="/cbf/dynamic/extra_margin" value="$(arg dynamic_extra_margin)" />
  <param name="/cbf/dynamic_scenario" value="$(arg dynamic_scenario)" />
  <param name="/cbf/trajectory_type" value="$(arg trajectory_type)" />
  <param name="/cbf/local_reference_mode" value="$(arg local_reference_mode)" />
  <param name="/cbf/mpc/spatial_pass" value="$(arg spatial_pass)" />
  <param name="/cbf/mpc/spatial_compiled_rollout" value="$(arg spatial_compiled_rollout)" type="bool" />
  <param name="/cbf/mpc/spatial_timeout_carry" value="$(arg spatial_timeout_carry)" type="bool" />
  <rosparam param="/cbf/mpc/spatial_lateral_extras" subst_value="true">$(arg spatial_lateral_extras)</rosparam>
  <rosparam param="/cbf/mpc/spatial_shift_durations" subst_value="true">$(arg spatial_shift_durations)</rosparam>
  <param name="/cbf/mpc/spatial_predictive_return" value="$(arg spatial_predictive_return)" type="bool" />
  <rosparam param="/cbf/mpc/spatial_return_durations" subst_value="true">$(arg spatial_return_durations)</rosparam>
  <param name="/cbf/mpc/spatial_activation_threshold" value="$(arg spatial_activation_threshold)" />
  <param name="/cbf/mpc/spatial_activation_preview_seconds" value="$(arg spatial_activation_preview_seconds)" />
  <param name="/cbf/mpc/spatial_runtime_guard" value="$(arg spatial_runtime_guard)" type="bool" />
  <param name="/cbf/mpc/spatial_prefix_retention" value="$(arg spatial_prefix_retention)" type="bool" />
  <param name="/cbf/scenario/ready" value="false" />
  <rosparam command="load" file="$(find tb3_distributed_control)/config/cbf_dynamic_scenarios.yaml" ns="/cbf/scenarios" />
  <rosparam command="load" file="$(arg active_scenario_file)" ns="/cbf/scenarios" />
  <param name="/cbf/active_experiment" value="$(arg active_experiment)" type="bool" />
  <param name="/cbf/two_robot_experiment" value="$(arg two_robot_experiment)" type="bool" />
  <param name="/cbf/five_robot_experiment" value="$(arg five_robot_experiment)" type="bool" />
  <rosparam param="/cbf/active_protocol">{}</rosparam>
  <rosparam command="load" file="$(arg active_protocol_file)" ns="/cbf/active_protocol" if="$(arg active_experiment)" />
  <node pkg="tb3_distributed_control" type="cbf_dynamic_scenario.py" name="cbf_dynamic_scenario" output="screen" if="$(eval arg('dynamic_scenario') != 'none')" />
  <param name="/cbf/output_dir" value="$(arg output_dir)" type="str" />
  <param name="/cbf/run_id" value="$(arg run_id)" />
  <param name="/cbf/world_file" value="$(arg world_name)" />
  <param name="/cbf/visualization/observer" value="$(arg geometry_observer)" type="int" />
  <param name="/cbf/visualization/debug" value="$(arg geometry_debug)" type="bool" />
  <node pkg="tb3_distributed_control" type="cbf_experiment_results.py" name="cbf_experiment_results" output="screen" />
  <node pkg="tb3_distributed_control" type="cbf_active_monitor.py" name="cbf_active_monitor" output="screen" if="$(arg active_experiment)" />
  <param name="/cbf/formation_radius" value="$(arg formation_radius)" />
  <param name="/cbf/sensor_ready_delay" value="$(arg sensor_ready_delay)" />
  <param name="/cbf/peer_safety" value="$(arg peer_safety)" />
  <param name="/cbf/peer_radius" value="$(arg peer_radius)" />
  <param name="/cbf/stall_recovery" value="$(arg stall_recovery)" />
  <param name="/cbf/realtime_solver" value="$(arg realtime_solver)" type="bool" />
  <param name="/cbf/control_budget_ms" value="$(arg control_budget_ms)" />
  <param name="/cbf/nlp_budget_ms" value="$(arg nlp_budget_ms)" />
  <param name="/cbf/dual_warm_start" value="$(arg dual_warm_start)" type="bool" />
  <param name="/cbf/stagger_callbacks" value="$(arg stagger_callbacks)" type="bool" />
  <param name="/cbf/leader_namespace" value="tb3_virtual_leader" />
  <param name="/cbf/obstacle_slots" value="12" />
  <param name="/cbf/data_timeout" value="0.6" />
  <env name="OPENBLAS_NUM_THREADS" value="1" />
  <env name="OMP_NUM_THREADS" value="1" />
  <env name="MKL_NUM_THREADS" value="1" />
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="extra_gazebo_args" value="$(eval '' if arg('gazebo_seed') == '' else '--seed ' + str(int(arg('gazebo_seed'))))" />
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="true" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="false" />
    <arg name="debug" value="false" />
  </include>
  <group ns="tb3_0">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_0" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_0" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_0/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_0 -x $(arg robot0_init_x) -y $(arg robot0_init_y) -z 0.01 -Y 0 -param robot_description" />
  </group>
  <node pkg="tb3_distributed_control" type="tb3_controller_node_cbf.py" name="tb3_controller_cbf_0" output="screen">
    <param name="robot_id" value="0" />
    <param name="static_accumulation" value="$(arg static_accumulation)" />
  </node>
  <group ns="tb3_1" if="$(eval int(arg('robot_count')) > 1)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_1" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_1" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_1/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_1 -x $(arg robot1_init_x) -y $(arg robot1_init_y) -z 0.01 -Y 0 -param robot_description" />
  </group>
  <node pkg="tb3_distributed_control" type="tb3_controller_node_cbf.py" name="tb3_controller_cbf_1" output="screen" if="$(eval int(arg('robot_count')) > 1)">
    <param name="robot_id" value="1" />
    <param name="static_accumulation" value="$(arg static_accumulation)" />
  </node>
  <group ns="tb3_2" if="$(eval int(arg('robot_count')) > 2)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_2" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_2" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_2/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_2 -x $(arg robot2_init_x) -y $(arg robot2_init_y) -z 0.01 -Y 0 -param robot_description" />
  </group>
  <node pkg="tb3_distributed_control" type="tb3_controller_node_cbf.py" name="tb3_controller_cbf_2" output="screen" if="$(eval int(arg('robot_count')) > 2)">
    <param name="robot_id" value="2" />
    <param name="static_accumulation" value="$(arg static_accumulation)" />
  </node>
  <group ns="tb3_3" if="$(eval int(arg('robot_count')) > 3)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_3" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_3" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_3/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_3 -x $(arg robot3_init_x) -y $(arg robot3_init_y) -z 0.01 -Y 0 -param robot_description" />
  </group>
  <node pkg="tb3_distributed_control" type="tb3_controller_node_cbf.py" name="tb3_controller_cbf_3" output="screen" if="$(eval int(arg('robot_count')) > 3)">
    <param name="robot_id" value="3" />
    <param name="static_accumulation" value="$(arg static_accumulation)" />
  </node>
  <group ns="tb3_4" if="$(eval int(arg('robot_count')) > 4)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_4" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_4" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_4/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_4 -x $(arg robot4_init_x) -y $(arg robot4_init_y) -z 0.01 -Y 0 -param robot_description" />
  </group>
  <node pkg="tb3_distributed_control" type="tb3_controller_node_cbf.py" name="tb3_controller_cbf_4" output="screen" if="$(eval int(arg('robot_count')) > 4)">
    <param name="robot_id" value="4" />
    <param name="static_accumulation" value="$(arg static_accumulation)" />
  </node>
  <node pkg="tb3_distributed_control" type="leader_node_cbf.py" name="leader_node" ns="tb3_virtual_leader" output="screen">
    <param name="total_time" value="$(arg total_time)" />
    <param name="trajectory_type" value="$(arg trajectory_type)" />
    <param name="leader_init_x" value="$(arg leader_init_x)" />
    <param name="leader_init_y" value="$(arg leader_init_y)" />
    <param name="leader_init_yaw" value="0" />
    <param name="virtual_leader_ns" value="tb3_virtual_leader" />
  </node>
  <node pkg="tb3_distributed_control" type="distributed_control_visualizer.py" name="distributed_control_visualizer" output="screen" if="$(eval int(arg('robot_count')) == 5)" />
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)" output="screen" if="$(arg open_rviz)" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom_global" args="0 0 0 0 0 0 world odom" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_virtual_leader_odom" args="0 0 0 0 0 0 world tb3_virtual_leader/odom" />
</launch>

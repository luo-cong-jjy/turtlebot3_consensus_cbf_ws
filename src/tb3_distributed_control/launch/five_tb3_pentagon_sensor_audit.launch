<launch><arg name="model" default="burger" /><arg name="robot_count" default="5" /><arg name="gui" default="false" /><arg name="paused" default="false" /><arg name="gazebo_seed" default="211" /><arg name="world_name" default="$(find tb3_distributed_control)/worlds/consensus_dynamic_obstacles.world" /><param name="/use_sim_time" value="true" /><include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="extra_gazebo_args" value="$(eval '' if arg('gazebo_seed') == '' else '--seed ' + str(int(arg('gazebo_seed'))))" />
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="true" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="false" />
    <arg name="debug" value="false" />
  </include>
  <group ns="tb3_0">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_0" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_0" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_0/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_0 -x 0.4000000000 -y 0.0000000000 -z 0.01 -Y 0 -param robot_description" />
  </group>
  <group ns="tb3_1" if="$(eval int(arg('robot_count')) &gt; 1)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_1" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_1" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_1/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_1 -x 0.1236067977 -y 0.3804226065 -z 0.01 -Y 0 -param robot_description" />
  </group>
  <group ns="tb3_2" if="$(eval int(arg('robot_count')) &gt; 2)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_2" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_2" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_2/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_2 -x -0.3236067977 -y 0.2351141009 -z 0.01 -Y 0 -param robot_description" />
  </group>
  <group ns="tb3_3" if="$(eval int(arg('robot_count')) &gt; 3)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_3" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_3" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_3/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_3 -x -0.3236067977 -y -0.2351141009 -z 0.01 -Y 0 -param robot_description" />
  </group>
  <group ns="tb3_4" if="$(eval int(arg('robot_count')) &gt; 4)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find tb3_distributed_control)/urdf/turtlebot3_$(arg model).urdf.xacro" />
    <param name="tf_prefix" value="tb3_4" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="tf_prefix" value="tb3_4" />
      <param name="publish_frequency" value="30" />
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world tb3_4/odom" />
    <node pkg="tb3_distributed_control" type="cbf_spawn_checked.py" name="spawn_urdf" args="-urdf -model tb3_4 -x 0.1236067977 -y -0.3804226065 -z 0.01 -Y 0 -param robot_description" />
  </group>
  </launch>
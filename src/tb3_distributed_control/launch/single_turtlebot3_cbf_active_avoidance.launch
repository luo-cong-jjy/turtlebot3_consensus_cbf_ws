<launch>
  <!-- New independent scenario suite; old scenes/algorithms are retained. -->
  <arg name="scenario" default="active_overtaking" />
  <arg name="rear_pass" default="false" />
  <arg name="gazebo_seed" default="211" />
  <arg name="gui" default="true" />
  <arg name="open_rviz" default="true" />
  <arg name="output_dir" default="" />
  <arg name="log_mpc_inputs" default="true" />
  <include file="$(find tb3_distributed_control)/launch/single_turtlebot3_cbf_cv_test.launch">
    <arg name="scenario" value="$(arg scenario)" />
    <arg name="active_experiment" value="true" />
    <arg name="rear_pass" value="$(arg rear_pass)" />
    <arg name="total_time" value="40" />
    <arg name="gazebo_seed" value="$(arg gazebo_seed)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="open_rviz" value="$(arg open_rviz)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="log_mpc_inputs" value="$(arg log_mpc_inputs)" />
  </include>
</launch>

<launch>
  <arg name="scenario" default="mixed" />
  <arg name="total_time" default="40" />
  <arg name="gui" default="true" />
  <arg name="open_rviz" default="true" />
  <arg name="geometry_debug" default="false" />
  <arg name="geometry_observer" default="0" />
  <arg name="output_dir" default="" />
  <arg name="prediction_mode" default="cv" />
  <arg name="dynamic_reaction_time" default="0.35" />
  <arg name="dynamic_extra_margin" default="0.02" />
  <include file="$(find tb3_distributed_control)/launch/multi_turtlebot3_consensus_gazebo_cbf.launch">
    <arg name="world_name" value="$(find tb3_distributed_control)/worlds/consensus_dynamic_obstacles.world" />
    <arg name="dynamic_prediction" value="true" />
    <arg name="static_accumulation" value="false" />
    <arg name="dynamic_scenario" value="$(arg scenario)" />
    <arg name="prediction_mode" value="$(arg prediction_mode)" />
    <arg name="dynamic_reaction_time" value="$(arg dynamic_reaction_time)" />
    <arg name="dynamic_extra_margin" value="$(arg dynamic_extra_margin)" />
    <arg name="total_time" value="$(arg total_time)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="open_rviz" value="$(arg open_rviz)" />
    <arg name="geometry_debug" value="$(arg geometry_debug)" />
    <arg name="geometry_observer" value="$(arg geometry_observer)" />
    <arg name="output_dir" value="$(arg output_dir)" />
  </include>
</launch>

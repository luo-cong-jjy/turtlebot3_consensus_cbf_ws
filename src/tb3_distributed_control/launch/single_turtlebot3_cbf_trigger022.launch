<launch>
  <arg name="spatial_predictive_return" default="true" />
  <arg name="motion_geometry_observer" default="mvee" />
  <arg name="circle_prior_retention" default="false" />
  <arg name="scenario" default="active_overtaking" />
  <arg name="gui" default="true" />
  <arg name="open_rviz" default="true" />
  <arg name="gazebo_seed" default="211" />
  <arg name="output_dir" default="" />
  <arg name="spatial_activation_preview_seconds" default="2.0" />
  <include file="$(find tb3_distributed_control)/launch/single_turtlebot3_cbf_dynamic.launch">
    <arg name="scenario" value="$(arg scenario)" />
    <arg name="total_time" value="40" />
    <arg name="active_experiment" value="true" />
    <arg name="spatial_pass" value="true" />
    <arg name="spatial_predictive_return" value="$(arg spatial_predictive_return)" />
    <arg name="spatial_shift_durations" value="[2.0,3.0,4.0]" />
    <arg name="spatial_activation_threshold" value="0.22" />
    <arg name="spatial_activation_preview_seconds" value="$(arg spatial_activation_preview_seconds)" />
    <arg name="spatial_compiled_rollout" value="true" />
    <arg name="spatial_timeout_carry" value="true" />
    <arg name="spatial_runtime_guard" value="true" />
    <arg name="spatial_prefix_retention" value="true" />
    <arg name="local_reference_mode" value="timed" />
    <arg name="prediction_mode" value="cv" />
    <arg name="motion_geometry_observer" value="$(arg motion_geometry_observer)" />
    <arg name="circle_prior_retention" value="$(arg circle_prior_retention)" />
    <arg name="execution_backup" value="true" />
    <arg name="transport_geometry" value="true" />
    <arg name="log_mpc_inputs" value="true" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="open_rviz" value="$(arg open_rviz)" />
    <arg name="gazebo_seed" value="$(arg gazebo_seed)" />
    <arg name="output_dir" value="$(arg output_dir)" />
  </include>
</launch>

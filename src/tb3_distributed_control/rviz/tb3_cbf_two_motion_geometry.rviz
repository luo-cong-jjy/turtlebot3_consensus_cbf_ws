Panels:
- Class: rviz/Displays
  Help Height: 172
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /TF1/Frames1
    - /TF1/Tree1
    - /Global Map1/Costmap1
    - /Global Map1/Planner1
    - /Local Map1/Polygon1
    - /Local Map1/Planner1
    - /Leader_consensus1
    Splitter Ratio: 0.5
  Tree Height: 1880
- Class: rviz/Selection
  Name: Selection
- Class: rviz/Tool Properties
  Expanded:
  - /2D Pose Estimate1
  - /2D Nav Goal1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz/Time
  Name: Time
  SyncMode: 0
  SyncSource: LaserScan_tb3_0
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz/Grid
    Color: 238; 238; 236
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz/MarkerArray
    Enabled: true
    Name: CBF measured observation envelopes (selected observer)
    Marker Topic: /cbf/geometry/ellipses
    Queue Size: 1
    Namespaces: {}
  - Class: rviz/MarkerArray
    Enabled: true
    Name: CBF robot envelopes (selected observer)
    Marker Topic: /cbf/geometry/peers
    Queue Size: 1
    Namespaces: {}
  - Alpha: 1
    Class: rviz/RobotModel
    Collision Enabled: false
    Enabled: true
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: Links in Alphabetic Order
    Name: Robot tb3_0
    Robot Description: /tb3_0/robot_description
    TF Prefix: tb3_0
    Update Interval: 0
    Value: false
    Visual Enabled: true
  - Alpha: 1
    Class: rviz/RobotModel
    Collision Enabled: false
    Enabled: true
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: Links in Alphabetic Order
    Name: Robot tb3_1
    Robot Description: /tb3_1/robot_description
    TF Prefix: tb3_1
    Update Interval: 0
    Value: false
    Visual Enabled: true
  - Class: rviz/MarkerArray
    Enabled: true
    Name: CBF predicted danger regions (selected observer)
    Marker Topic: /cbf/geometry/prediction_regions
    Queue Size: 1
    Namespaces: {}
  - Class: rviz/MarkerArray
    Enabled: false
    Name: tb3_0 own predicted regions
    Marker Topic: /tb3_0/cbf_geometry/prediction_regions
    Queue Size: 1
    Namespaces: {}
  - Class: rviz/MarkerArray
    Enabled: false
    Name: tb3_1 own predicted regions
    Marker Topic: /tb3_1/cbf_geometry/prediction_regions
    Queue Size: 1
    Namespaces: {}
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 15
  Name: root
  Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Interact
    Hide Inactive Objects: true
  - Class: rviz/Select
  - Class: rviz/SetInitialPose
    Theta std deviation: 0.2617993950843811
    Topic: tb3_0//initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
  - Class: rviz/SetGoal
    Topic: tb3_0/move_base_simple/goal
  - Class: rviz/SetInitialPose
    Theta std deviation: 0.2617993950843811
    Topic: tb3_1//initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
  - Class: rviz/SetGoal
    Topic: tb3_1/move_base_simple/goal
  - Class: rviz/SetInitialPose
    Theta std deviation: 0.2617993950843811
    Topic: tb3_2//initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
  - Class: rviz/SetGoal
    Topic: tb3_2/move_base_simple/goal
  - Class: rviz/SetInitialPose
    Theta std deviation: 0.2617993950843811
    Topic: tb3_3//initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
  - Class: rviz/SetGoal
    Topic: tb3_3/move_base_simple/goal
  - Class: rviz/SetInitialPose
    Theta std deviation: 0.2617993950843811
    Topic: tb3_4//initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
  - Class: rviz/SetGoal
    Topic: tb3_4/move_base_simple/goal
  - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: -12.570830345153809
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 150
      Target Frame: <Fixed Frame>
      X: 3.0
      Y: 0.0
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  QMainWindow State: 
  Hide Left Dock: true
  Hide Right Dock: true
  Image:
    collapsed: false
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1280
  X: 0
  Y: 0
